# Cross-language canonical collection transaction locks
data/articles/.collection.lock/
data/articles/.merge.lock

# Recoverable private collection transaction (may contain draft HTML)
data/articles/.collection-transaction.json

# Verified RSS coverage is durable resumability evidence
!data/runs/*/*/run/collection-capture.json

# Frozen per-run policy and per-paper policy mapping survive checkout/cache loss
!data/runs/*/*/run/processing-policy.json
!data/runs/*/*/run/paper-policies.json
data/runs/.paper-policy.lock/

# One copy per distinct imported policy; model inputs are disposable
!data/runs/*/*/run/policies/*.json
**/.cache/
