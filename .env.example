# Hosted runtime values, set with native Sites environment tools (not source).
# Optional owner pin for non-Sites deployments or stricter application checks.
OWNER_USER_ID=
TRUSTED_AUTH_HEADER=
# Set confirmed only after get_site verifies owner-private access and Sites-only ingress.
SITES_OWNER_PRIVATE=
SITES_STORAGE_ENABLED=false
# Python process only. Service token must match the exact HTTPS Site origin.
READER_SITE_URL=
SITES_SERVICE_TOKEN=
# Required managed bindings: DB (D1), IMAGES (private R2), ASSETS.
